# Use Debian-based Python image
FROM python:3.10-bullseye

# Install dependencies for dlib and face_recognition
RUN apt-get update && apt-get install -y \
    cmake \
    build-essential \
    libopenblas-dev \
    liblapack-dev \
    libx11-dev \
    libgtk-3-dev \
    libboost-all-dev \
    python3-dev \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install face_recognition with prebuilt binaries
RUN pip install --upgrade pip \
    && pip install face_recognition

# Install other Python requirements
COPY requirements.txt .
RUN pip install -r requirements.txt

# Copy your application code
COPY . /app
WORKDIR /app

# Expose port
EXPOSE 8000

# Run the app
CMD ["gunicorn", "main:app", "-k", "uvicorn.workers.UvicornWorker", "--host", "0.0.0.0", "--port", "8000"]
